{
  "manifest_version": 3,
  "name": "GitHub YouTube Player",
  "version": "1.0.0",
  "description": "Watch YouTube videos while you work on GitHub, with a compact player available from any GitHub page.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://youtu.be/*", "https://github.com/*"],
  "action": {
    "default_title": "YouTube Player",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
